model DailyPlan {
  id          String   @id @default(cuid())
  orgId       String
  planDate    DateTime
  priorities  Json     @default("[]")
  narrative   String
  metrics     Json     @default("{}")
  generatedBy String   @default("ai")
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, planDate])
}

// ===========================================================================
// Demand engine
// ===========================================================================

/// A dated thing that happened in the world.
///
/// The acquisition pattern this replaces was: find a company, match its
/// category, infer a generic need, score it. That pattern cannot produce
/// demand, because none of its inputs is an event — a gym existing is not a
/// cleaning opportunity, whereas a gym opening in three weeks is.
enum DemandEventType {
  /// Someone is asking for proposals or quotes right now.
  ACTIVE_RFP
  ACTIVE_RFQ
  PROCUREMENT_NOTICE
  VENDOR_REQUEST
  /// A prime or facilities company is asking for local fulfilment capacity.
  SUBCONTRACTOR_REQUEST
  /// Work was awarded to someone. Evidence of a prime, not of open demand.
  CONTRACT_AWARD
  FACILITY_OPENING
  /// Certificate of occupancy, operating licence, health permit.
  OCCUPANCY_OR_OPERATING_APPROVAL
  RENOVATION_OR_CONSTRUCTION
  EXPANSION
  PROPERTY_TURNOVER
  NEW_LOCATION
  NEW_LEASE
  CONTRACT_EXPIRATION
  VENDOR_FAILURE_OR_COMPLAINT
  STAFFING_OR_CAPACITY_GAP
  /// They contacted us. The only kind we do not have to go and find.
  INBOUND_REQUEST
}

/// Where an event is in its own life, separate from any opportunity built on it.
enum EventLifecycle {
  DISCOVERED
  VERIFIED
  /// Held because its identity or facts could not be established. Never merged
  /// or deleted on a guess.
  QUARANTINED
  /// Its window closed. Kept, because an expired event is still evidence.
  EXPIRED
  REJECTED
  /// A better record of the same event exists.
  SUPERSEDED
}

/// How much of an event has actually been checked.
enum DemandVerification {
  /// Taken from the source and not yet examined.
  UNVERIFIED
  /// Machine checks passed: date present and current, org resolved, location real.
  AUTO_VERIFIED
  /// A person confirmed it, by call or by reading the source.
  HUMAN_VERIFIED
  /// Checked and found wrong.
  FAILED
}

/// How much relationship work an opportunity demands.
///
/// Deliberately separate from tier. A federal solicitation is unambiguous
/// demand and a miserable relationship; an independent gym opening is a weaker
/// signal and a single phone call. Conflating the two is how "recurring
/// revenue" gets mistaken for "easy".
enum FrictionLevel {
  LOW
  MODERATE
  HIGH
  /// Not yet assessable. Must never be presented as LOW.
  UNKNOWN_RESEARCH_REQUIRED
}

/// The role a company plays in one event. The same company is a buyer in one
/// event and a prime contractor in another.
enum EventPartyRole {
  /// Owns the need and the budget.
  BUYER
  /// Holds the property.
  PROPERTY_OWNER
  /// Runs the site day to day.
  PROPERTY_MANAGER
  /// Won the work and may need local capacity.
  PRIME_CONTRACTOR
  /// Named as doing the work.
  INCUMBENT_PROVIDER
  /// Filed the permit or licence. Often an agent, not the buyer.
  APPLICANT
  /// The authority that published the record.
  ISSUING_AUTHORITY
  /// Referenced but whose part is not yet established.
  MENTIONED
}

model DemandEvent {
  id    String @id @default(cuid())
  orgId String

  type         DemandEventType
  lifecycle    EventLifecycle     @default(DISCOVERED)
  verification DemandVerification @default(UNVERIFIED)

  /// Which connector produced it, and its identifier there. Together with
  /// `dedupeKey` these make re-ingesting the same record a no-op.
  connector      String
  sourceRecordId String
  sourceUrl      String?
  /// The source's own words, kept so a claim can always be checked against it.
  rawPayload     Json    @default("{}")

  /// The date the source states the event happened or will happen.
  ///
  /// Required for tier A and B. Never our ingestion time — that is
  /// `discoveredAt`, stored separately and deliberately unusable as an event
  /// date anywhere in the pipeline.
  eventDate    DateTime?
  discoveredAt DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  /// Whichever of these the event type carries.
  deadlineAt   DateTime?
  opensAt      DateTime?
  completesAt  DateTime?
  effectiveAt  DateTime?

  headline String
  /// The source's own description, untouched.
  summary  String

  /// Location as the source gave it. Never a search anchor or market name.
  cityName     String?
  stateCode    String?
  postalCode   String?
  addressLine1 String?

  /// Facts the source states outright.
  confirmedFacts Json     @default("[]")
  /// What we concluded from them. Never presented as stated.
  inferredFacts  Json     @default("[]")
  /// Named but unresolved organisations and people.
  mentionedNames String[] @default([])

  /// 0–1, how much the record itself can be trusted.
  confidence        Float @default(0.5)
  /// 0–1, how reliable this connector has proven.
  sourceReliability Float @default(0.5)

  /// Capabilities the event plausibly requires. Inference, labelled as such.
  relatedCapabilities String[] @default([])

  /// Identity for deduplication across sources: permit number, solicitation
  /// number, address+date, project id.
  dedupeKey String

  expiredReason    String?
  rejectedReason   String?
  quarantineReason String?
  lastVerifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parties  DemandEventParty[]
  routes   RouteHypothesis[]
  evidence SourceEvidence[]

  @@unique([orgId, dedupeKey])
  @@index([orgId, lifecycle, eventDate])
  @@index([orgId, type, eventDate])
  @@index([orgId, connector, discoveredAt])
}

/// One event involves several organisations, each in a different part.
model DemandEventParty {
  id        String  @id @default(cuid())
  eventId   String
  companyId String?

  role                 EventPartyRole
  /// The name exactly as the source wrote it, kept even once resolved.
  sourceName           String
  /// How sure we are this is the right company. Below the bar, `companyId`
  /// stays null and the name is held for review rather than guessed at.
  resolutionConfidence Float          @default(0)
  resolutionMethod     String?

  createdAt DateTime @default(now())

  event   DemandEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  company Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([eventId, role, sourceName])
  @@index([companyId])
}

/// A commercial route built from an event.
///
/// One verified event can support several: a gym opening creates a
/// pre-opening clean and a recurring contract (brokerage) and an initial
/// consumables order and a replenishment (distribution). It creates a
/// subcontracting route only when a prime or a capacity request is in evidence.
model RouteHypothesis {
  id        String  @id @default(cuid())
  orgId     String
  eventId   String
  /// The account this route is for. One account, many routes beneath it.
  companyId String
  pathId    String?

  route       SignalCategory
  /// Which playbook entry produced it, so the reasoning is traceable.
  playbookKey String
  headline    String
  /// Why this route exists at all, in the operator's language.
  rationale   String

  tier            LeadTier      @default(DIRECTORY_PROSPECT)
  friction        FrictionLevel @default(UNKNOWN_RESEARCH_REQUIRED)
  frictionReason  String?
  frictionFactors Json          @default("[]")

  /// Whether the need is stated by a source or concluded by us.
  needIsConfirmed    Boolean        @default(false)
  requiredCapability String?
  buyerRole          EventPartyRole @default(BUYER)

  buyingWindow   String?
  windowOpensAt  DateTime?
  windowClosesAt DateTime?

  /// Supply side.
  fulfilmentStatus String @default("UNKNOWN")
  providerCount    Float  @default(0)

  /// Economics, null wherever they cannot honestly be estimated.
  estimatedBuyerPrice   Decimal? @db.Decimal(14, 2)
  estimatedProviderCost Decimal? @db.Decimal(14, 2)
  estimatedGrossProfit  Decimal? @db.Decimal(14, 2)
  estimatedHumanMinutes Int?
  economicsBasis        String?

  /// Chosen commercial structure, and why. Never taken from the connector name.
  commercialStructure String?
  structureReason     String?

  /// Why this company, why now, and what remains unknown.
  ///
  /// Written for a person about to make the call. Held as structured JSON
  /// rather than prose so each part can be checked for presence — an
  /// opportunity missing its stakeholder hypothesis is missing something
  /// specific, not merely thin.
  thesis Json?

  /// Working capital and counterparty risk. Null where genuinely unknown:
  /// a default here would be an invented number wearing a calculation's
  /// clothes.
  maxCashExposure    Decimal?  @db.Decimal(14, 2)
  daysCapitalExposed Int?
  paymentRisk        RiskLevel @default(UNKNOWN)
  counterpartyRisk   RiskLevel @default(UNKNOWN)
  complianceStatus   String    @default("UNKNOWN")
  /// Requirements we cannot currently satisfy. Non-empty blocks pursuit.
  complianceGaps     String[]  @default([])
  riskNotes          Json      @default("[]")

  /// Fulfilment detail, beyond the headline status.
  fulfilmentReason   String?
  matchedProviderIds String[] @default([])

  status       String    @default("RESEARCH")
  statusReason String?
  missingInfo  String[]  @default([])
  nextAction   String?
  nextActionBy DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event   DemandEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  path    BusinessPath? @relation(fields: [pathId], references: [id], onDelete: SetNull)

  outreach         OutreachState?
  outreachAttempts OutreachAttempt[]
  packetItems      PacketItem[]
  incidents        WorkIncident[]

  requirements       BuyerRequirement[]
  providerCandidates ProviderCandidate[]
  quotes             RouteQuote[]
  deal               RouteDeal?
  dealEvents         DealEvent[]
  tasks              Task[]
  approvals          Approval[]
  rooms              DealRoom[]
  messages           Message[]

  @@unique([eventId, companyId, playbookKey])
  @@index([orgId, tier, friction])
  @@index([orgId, route, status])
}

/// One attempt by one connector, kept whether it succeeded or not.
///
/// A source that silently returns nothing looks identical to a quiet week, and
/// the difference is the whole question when discovery produces no demand.
model SourceRun {
  id           String  @id @default(cuid())
  orgId        String
  dataSourceId String?
  connector    String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING")

  recordsExamined Int @default(0)
  eventsCreated   Int @default(0)
  eventsUpdated   Int @default(0)
  eventsRejected  Int @default(0)

  /// Where the next run should resume from.
  cursor      String?
  windowStart DateTime?
  windowEnd   DateTime?

  error   String?
  details Json    @default("{}")

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dataSource DataSource?  @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)

  @@index([orgId, connector, startedAt])
}

/// How much risk an input carries, where it can be judged at all.
///
/// UNKNOWN is a real value and the default. A missing payment history is not
/// a good payment history, and defaulting it to LOW would put unverified
/// counterparties at the top of the queue.
enum RiskLevel {
  LOW
  MODERATE
  HIGH
  UNKNOWN
}

/// One step in the chain from a source record to collected money.
///
/// The chain is recorded from the beginning even though the later stages will
/// be empty for months, because a source's worth is decided by completed paid
/// jobs and nothing else. Counting records discovered is how a source that
/// produces fifty thousand companies and no revenue looks productive.
enum OutcomeStage {
  SOURCE_RECORD
  DEMAND_EVENT
  VERIFIED_LEAD
  CONTACTED
  RESPONDED
  QUALIFIED_CONVERSATION
  QUOTED
  WON
  LOST
  COMPLETED
  PAID
}

model DemandOutcome {
  id    String @id @default(cuid())
  orgId String

  /// Which connector and playbook produced this. Both, because a source that
  /// feeds a good playbook and a bad one has two different track records.
  connector   String
  playbookKey String?
  route       SignalCategory?

  eventId String?
  routeId String?

  stage                OutcomeStage
  occurredAt           DateTime     @default(now())
  /// Set when money actually moved. Never an expectation.
  collectedRevenue     Decimal?     @db.Decimal(14, 2)
  collectedGrossProfit Decimal?     @db.Decimal(14, 2)
  humanMinutes         Int?
  note                 String?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// One row per (route, stage): a lead that is contacted twice has one
  /// contacted milestone, so counts stay milestones rather than activity.
  @@unique([routeId, stage])
  @@index([orgId, connector, stage])
  @@index([orgId, occurredAt])
}

// ===========================================================================
// Outreach: what happened when somebody actually worked the opportunity
// ===========================================================================

/// Where a route sits in the calling workflow.
///
/// Distinct from `RouteHypothesis.status`, which is the engine's judgement
/// about the opportunity. This is the operator's: the engine can say PURSUE
/// while the operator has left three voicemails, and neither fact should
/// overwrite the other.
enum OutreachStatus {
  /// Never worked.
  NEW
  /// Called, nobody reached.
  ATTEMPTED
  /// Spoke to somebody who is not the decision-maker.
  IN_CONVERSATION
  /// Parked until a date. Out of the calling queue until then.
  FOLLOW_UP
  /// Worth real pursuit. Out of cold calling, into the pipeline.
  QUALIFIED
  /// Somebody already has this. Not a loss, not work.
  CLOSED_HANDLED
  CLOSED_NOT_INTERESTED
  CLOSED_BAD_FIT
  /// They asked not to be contacted. Never returned by any queue.
  DO_NOT_CONTACT
}

/// The outcome of one attempt, recorded once per attempt and never edited.
enum CallDisposition {
  NO_ANSWER
  LEFT_VOICEMAIL
  GATEKEEPER
  WRONG_NUMBER
  /// Somebody who can speak to the requirement, who is not necessarily the
  /// person who signs.
  REACHED_RELEVANT_PERSON
  /// We now know who decides. Not the same as having spoken to them.
  DECISION_MAKER_IDENTIFIED
  REACHED_DECISION_MAKER
  /// They told us the need is real. The strongest thing a call can establish.
  NEED_CONFIRMED
  /// They told us it is not. A negative answer is a finding, not a failure.
  NEED_UNCONFIRMED
  /// They asked for a price. The first point at which economics are real.
  QUOTE_REQUESTED
  INTERESTED
  NEEDS_INFORMATION
  FOLLOW_UP
  QUALIFIED_OPPORTUNITY
  ALREADY_HANDLED
  NOT_INTERESTED
  BAD_FIT
  DO_NOT_CONTACT
}

/// Current calling state for one route. One row, updated in place.
model OutreachState {
  id      String @id @default(cuid())
  orgId   String
  routeId String @unique

  status          OutreachStatus   @default(NEW)
  /// Out of the calling queue until this passes. The single field that makes
  /// "follow up on Tuesday" mean anything.
  snoozeUntil     DateTime?
  attempts        Int              @default(0)
  lastAttemptAt   DateTime?
  lastDisposition CallDisposition?

  /// Corrections and facts learned on a call. Kept apart from the event's own
  /// evidence, which is the source's and is never rewritten by an operator.
  contactName      String?
  contactRole      String?
  correctedPhone   String?
  correctedEmail   String?
  confirmedNeed    String?
  confirmedTiming  String?
  budgetNote       String?
  incumbentStatus  String?
  preferredRoute   SignalCategory?
  disqualifyReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route RouteHypothesis @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([orgId, status, snoozeUntil])
}

/// One attempt. Append-only: rows are inserted and never updated or deleted,
/// so the history of what was tried survives every later correction.
/// What the caller learned, in the shape the route actually needs.
///
/// On the attempt rather than in a table of its own, because it is a fact
/// about one conversation and the attempt is already append-only. A giant
/// notes field cannot answer "how many buyers named a reorder cycle"; these
/// can, and they are what the after-call gate checks.
model OutreachAttempt {
  id      String  @id @default(cuid())
  orgId   String
  routeId String
  /// Null when the operator could not be identified, rather than guessed at.
  userId  String?

  disposition     CallDisposition
  notes           String?
  /// Route-specific answers, in the shape the route actually needs.
  ///
  /// Here rather than in a table of its own: it is a fact about one
  /// conversation and the attempt is already append-only. A giant notes field
  /// cannot answer "how many buyers named a reorder cycle"; this can, and it
  /// is what the after-call gate checks before serving the next opportunity.
  discovery       Json            @default("{}")
  /// What the operator saw at the time, so a later engine change cannot make
  /// the record of the call disagree with the call.
  contextSnapshot Json            @default("{}")

  occurredAt DateTime @default(now())

  org   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route RouteHypothesis @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Requirement versions this call produced. A requirement traces back to the
  /// conversation it came from, or it is ours rather than theirs.
  requirements BuyerRequirement[]

  @@index([orgId, occurredAt])
  @@index([routeId, occurredAt])
}

// ---------------------------------------------------------------------------
// Contact resolution
// ---------------------------------------------------------------------------

/// Where one organisation's contact resolution has got to.
///
/// Deliberately more than a boolean. "We have not looked yet", "we looked and
/// found nothing", "we found two businesses and cannot tell them apart" and
/// "the provider was down" are four different situations with four different
/// remedies, and a single `enriched` flag would present all of them to the
/// operator as the same empty phone column.
enum ContactResolutionStatus {
  /// Scheduled, not yet attempted, or waiting for its next attempt.
  QUEUED
  /// Claimed by a worker right now.
  IN_PROGRESS
  /// A defensible contact route was found and written.
  RESOLVED
  /// Competing candidates that the evidence cannot separate. Needs a person.
  AMBIGUOUS
  /// Every available source was searched and none published a contact.
  UNRESOLVED
  /// The attempt itself failed: outage, timeout, or missing configuration.
  /// Never to be shown as "no contact exists".
  FAILED
}

/// How much the contact we hold can be relied on.
enum ContactConfidence {
  /// The organisation and the location both corroborate, or a person confirmed it.
  VERIFIED
  /// The organisation matches and the location is consistent, but not proven
  /// to the street address.
  PROBABLE
  /// More than one business fits and the evidence cannot choose.
  AMBIGUOUS
  /// Searched, nothing defensible found.
  UNRESOLVED
  /// The search could not be completed.
  FAILED
}

/// What a contact value actually reaches.
///
/// The distinction that stops a franchisor's head office number being dialled
/// as though it were the branch that just took occupancy.
enum ContactScope {
  /// This site.
  LOCATION
  /// A parent, franchisor or central switchboard. Real, and not this branch.
  PARENT_OR_CENTRAL
  UNKNOWN
}

/// One organisation's place in the contact-resolution workflow.
///
/// Keyed by company, not by route. A gym opening produces four commercial
/// routes and there is still only one phone number to find, so resolution is
/// shared and the four routes are released together.
model ContactResolution {
  id        String @id @default(cuid())
  orgId     String
  companyId String @unique

  status     ContactResolutionStatus @default(QUEUED)
  confidence ContactConfidence?

  /// The remaining blocker in the operator's words. Non-null whenever the
  /// status is not RESOLVED, so "Research needed" can always say why.
  blocker String?

  /// Every source consulted, cumulative, so the interface can say what has
  /// already been tried without anybody opening a job record.
  sourcesAttempted String[] @default([])
  /// The sources consulted on the most recent attempt only.
  lastSources      String[] @default([])

  attempts          Int @default(0)
  /// Transient failures since the last success. Drives the backoff, and is
  /// reset by any completed attempt so an outage does not permanently
  /// exhaust a record's retries.
  transientFailures Int @default(0)

  lastAttemptAt DateTime?
  resolvedAt    DateTime?
  nextAttemptAt DateTime?

  /// Claim fields. Two workers cannot process the same organisation because
  /// the claim is a conditional update, the same pattern the job queue uses.
  lockedAt DateTime?
  lockedBy String?

  /// Competing candidates when the status is AMBIGUOUS, so a person can pick
  /// one instead of starting the search again.
  candidates      Json    @default("[]")
  ambiguityReason String?

  /// Why the attempt failed, kept apart from "no contact found".
  failureKind    String?
  failureDetail  String?
  /// Exactly what to change to make the source work. Null when there is
  /// nothing an operator could do.
  fixInstruction String?

  /// Contact values already established as wrong — a caller reached them and
  /// said so. The next attempt must not propose them again.
  rejectedValues String[] @default([])

  /// What the inputs looked like when this was last attempted. When the
  /// company or its events gain new information the fingerprint changes and
  /// the record is retried even though nothing else did.
  sourceFingerprint String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([orgId, status, nextAttemptAt])
  @@index([orgId, status, lockedAt])
}

/// Where one contact value came from.
///
/// Append-only in practice: a value that is superseded is stamped rather than
/// deleted, so a provider outage or a weaker later source can never quietly
/// erase what a caller confirmed. Every field the workflow writes gets a row,
/// which is what makes "do not overwrite stronger verified data with weaker
/// scraped data" a check rather than an intention.
model ContactProvenance {
  id        String @id @default(cuid())
  orgId     String
  companyId String

  /// phone | website | email | contactName | contactRole | location
  field String
  value String

  /// The adapter or person that produced it.
  source     String
  sourceUrl  String?
  externalId String?

  retrievedAt DateTime          @default(now())
  confidence  ContactConfidence
  scope       ContactScope      @default(UNKNOWN)

  /// True only when the value was checked, not merely found. A generated
  /// email pattern is never verified.
  verified          Boolean @default(false)
  enteredByOperator Boolean @default(false)

  /// How this value was arrived at, for the caller card.
  matchMethod String?

  /// Set when a stronger value replaced it, or a caller established it was
  /// wrong. The row itself is kept.
  supersededAt     DateTime?
  supersededReason String?

  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, field, value])
  @@index([orgId, companyId, field])
}

// ---------------------------------------------------------------------------
// Caller execution
// ---------------------------------------------------------------------------

enum PacketStatus {
  OPEN
  COMPLETE
  EXPIRED
  CANCELLED
}

/// Where one opportunity has got to inside one caller's packet.
enum PacketItemStatus {
  /// Assigned and not yet started.
  PENDING
  /// Claimed by the caller right now, with a lease.
  IN_PROGRESS
  /// An attempt was recorded against it.
  WORKED
  /// Deliberately passed over, with a reason.
  SKIPPED
  /// Handed back — expired, reassigned, or no longer servable.
  RETURNED
}

/// A controlled portfolio of work handed to one caller.
///
/// Not a fixed-order cold list. The order adapts at serve time — a callback
/// promised for eleven o'clock outranks a cold Tier A record at eleven o'clock
/// — but ownership does not move with it, so two callers can never be working
/// the same organisation while each believes it is theirs.
///
/// The versions are recorded because a result is only interpretable against
/// the script, process and offer that were in force when the work was done.
/// Comparing this month's conversion against last month's without them
/// compares two different experiments and calls the difference performance.
model WorkPacket {
  id       String @id @default(cuid())
  orgId    String
  callerId String

  name   String
  status PacketStatus @default(OPEN)

  assignedAt  DateTime  @default(now())
  expiresAt   DateTime?
  completedAt DateTime?

  /// In force when this packet was created.
  scriptVersion  String?
  processVersion String?
  offerVersion   String?

  /// What the caller is trying to learn, beyond making contact.
  discoveryObjective String?
  /// Stable cohort label, so an experiment is not re-randomised per record.
  experimentCohort   String?

  /// How many items must be worked before the packet is finished. Null means
  /// every one of them.
  completionTarget Int?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  caller User         @relation("PacketCaller", fields: [callerId], references: [id], onDelete: Cascade)
  items  PacketItem[]

  @@index([orgId, callerId, status])
  @@index([orgId, status, expiresAt])
}

/// One opportunity inside one packet, and who currently owns it.
///
/// The unique index on the active rows is the guarantee: a route can be
/// PENDING or IN_PROGRESS in exactly one packet at a time. It is a partial
/// index, written by hand in the migration, because "two callers must not both
/// be told this is theirs" is a database invariant and not a convention.
model PacketItem {
  id       String @id @default(cuid())
  orgId    String
  packetId String
  routeId  String
  /// Copied from the packet so the "one live record per caller" invariant can
  /// be a partial unique index rather than a query somebody has to remember.
  /// A caller holding two records at once has one of them going cold behind a
  /// thirty-minute lease, which is exactly what two browser tabs produce.
  callerId String

  status   PacketItemStatus @default(PENDING)
  /// The order the packet was built in. Serve-time ordering may differ.
  position Int              @default(0)

  /// Lease. A caller who closes the tab does not hold the record forever.
  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  workedAt       DateTime?
  skippedReason  String?
  returnedReason String?

  /// Where it came from, when it was moved between callers.
  reassignedFromPacketId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  packet WorkPacket      @relation(fields: [packetId], references: [id], onDelete: Cascade)
  route  RouteHypothesis @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([packetId, routeId])
  @@index([orgId, status])
  @@index([routeId, status])
  @@index([callerId, status])
}

/// Something the system did wrong, kept apart from something a caller did wrong.
///
/// The distinction is the whole point. A save that failed, a stale assignment,
/// a dialer outage — these stop a caller working and must never be counted
/// against them, or read later as a caller who went quiet. An incident records
/// what broke, preserves what the caller had typed, and is resolved by somebody
/// looking at it rather than by time passing.
enum IncidentKind {
  SAVE_FAILURE
  ASSIGNMENT_CONFLICT
  STALE_ASSIGNMENT
  ELIGIBILITY_CHANGED
  INTEGRATION_FAILURE
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model WorkIncident {
  id       String  @id @default(cuid())
  orgId    String
  callerId String?
  routeId  String?

  kind   IncidentKind
  status IncidentStatus @default(OPEN)

  detail    String
  /// Exactly what the caller had entered when it broke, so nothing they typed
  /// is lost to a failure that was not theirs.
  preserved Json   @default("{}")

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  resolution String?

  org    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  caller User?            @relation("IncidentCaller", fields: [callerId], references: [id], onDelete: SetNull)
  route  RouteHypothesis? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@index([orgId, status, createdAt])
  @@index([orgId, callerId, status])
}

// ---------------------------------------------------------------------------
// Deal progression: buyer requirement, provider workstream, economics, money
//
// Built on RouteHypothesis, which is the live opportunity in this system. The
// older Opportunity/Deal/Quote layer is fed by DiscoverySignal promotion and is
// not on the demand-engine path; nothing here writes to it, and nothing here
// reads it as truth.
//
// The organising principle of this whole section is that a fact and a hope are
// stored in different columns. An estimate never lands in a realised field, a
// provider candidate never lands in a committed field, and an invoice is never
// counted as money. Every place those could blur, the schema splits them.
// ---------------------------------------------------------------------------

/// How the buyer's money decision actually gets made.
///
/// "No budget" and "unknown" are different answers and both are useful: the
/// first closes a route, the second names the next question.
enum BudgetMechanism {
  UNKNOWN
  NO_BUDGET
  BUDGET_STATED
  QUOTE_REQUESTED
  FORMAL_BID
  RENEWAL_CYCLE
}

enum RequirementState {
  /// Captured but not yet enough to price.
  DRAFT
  /// The live requirement. At most one per route.
  CURRENT
  /// Replaced by a newer version. Kept forever.
  SUPERSEDED
  /// The buyer told us there is no requirement.
  WITHDRAWN
}

/// What the buyer said they need, as a version rather than a moving row.
///
/// Requirements change during a deal, and a quote priced against the January
/// scope is not wrong because the scope changed in March — it is a quote for a
/// different requirement. Versioning is what lets both statements be true, and
/// it is why nothing here is ever updated in place once it has been priced.
model BuyerRequirement {
  id      String @id @default(cuid())
  orgId   String
  routeId String
  version Int

  state RequirementState @default(CURRENT)

  /// The requirement in one line, for a person scanning a list.
  summary       String
  specification String?
  quantity      String?
  unit          String?
  frequency     String?
  locationCount Int?
  locations     String?
  startsAt      DateTime?
  decisionBy    DateTime?
  /// Timing exactly as the buyer put it. "Sometime after budget season" is a
  /// real answer and it is not a date; parsing it into one would invent a
  /// precision they did not give us, and dropping it would lose the answer.
  timingNote    String?
  processNotes  String?
  constraints   String[]  @default([])

  incumbent      String?
  incumbentNotes String?

  decisionMakerContactId String?
  decisionMakerRole      String?
  /// Whether we know who signs, as opposed to having a plausible name.
  authorityConfirmed     Boolean @default(false)

  budgetMechanism BudgetMechanism @default(UNKNOWN)
  budgetAmount    Decimal?        @db.Decimal(14, 2)
  budgetBasis     String?

  /// Field names the buyer actually stated. Anything absent from this list is
  /// our inference, and the UI is required to label it as ours. Without it a
  /// requirement reads as though the buyer confirmed every line of it.
  confirmedFields String[] @default([])

  /// Where this version came from.
  sourceAttemptId String?
  capturedById    String?
  capturedBy      String    @default("caller")
  supersededById  String?   @unique
  supersededAt    DateTime?
  supersedeReason String?
  withdrawnReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org            Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route          RouteHypothesis   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sourceAttempt  OutreachAttempt?  @relation(fields: [sourceAttemptId], references: [id], onDelete: SetNull)
  capturedByUser User?             @relation("RequirementCapturedBy", fields: [capturedById], references: [id], onDelete: SetNull)
  decisionMaker  Contact?          @relation("RequirementDecisionMaker", fields: [decisionMakerContactId], references: [id], onDelete: SetNull)
  supersededBy   BuyerRequirement? @relation("RequirementVersions", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     BuyerRequirement? @relation("RequirementVersions")
  quotes         RouteQuote[]
  rooms          DealRoom[]

  @@unique([routeId, version])
  @@index([orgId, state])
}

/// How far one provider has got on one route.
///
/// The whole point of an explicit ladder is that "we found somebody who might
/// be able to do this" and "somebody has agreed to do this" are eight steps
/// apart, and a single `matched` boolean presents them as the same thing.
enum ProviderWorkState {
  CANDIDATE_FOUND
  CONTACTED
  CAPABILITY_VERIFIED
  AVAILABILITY_VERIFIED
  COST_RECEIVED
  SELECTED
  COMMITTED
  REJECTED
  WITHDRAWN
}

model ProviderCandidate {
  id                String @id @default(cuid())
  orgId             String
  routeId           String
  providerCompanyId String

  state          ProviderWorkState @default(CANDIDATE_FOUND)
  stateReason    String?
  stateChangedAt DateTime          @default(now())

  /// Why this provider is a candidate at all, in words. A score is not a reason.
  matchBasis      String
  capabilityNotes String?
  geographyNotes  String?

  capabilityVerifiedAt   DateTime?
  capabilityEvidence     String?
  credentialsVerifiedAt  DateTime?
  credentialsEvidence    String?
  availabilityVerifiedAt DateTime?
  availableFrom          DateTime?
  availableUntil         DateTime?
  capacityNotes          String?

  /// Cost as quoted by the provider, with the date it stops being true.
  /// A cost without an expiry silently becomes a guess.
  costAmount     Decimal?  @db.Decimal(14, 2)
  costUnit       String?
  costBasis      String?
  costTerms      String?
  costReceivedAt DateTime?
  costExpiresAt  DateTime?

  promiseText   String?
  promiseDueAt  DateTime?
  promiseKeptAt DateTime?

  /// Set when this company is also the buyer on this route, or is the buyer on
  /// another live route. Surfaced rather than blocked: it is sometimes correct
  /// and always worth knowing before a caller phones them.
  conflictNote String?

  rejectedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route    RouteHypothesis @relation(fields: [routeId], references: [id], onDelete: Cascade)
  provider Company         @relation("ProviderCandidateCompany", fields: [providerCompanyId], references: [id], onDelete: Cascade)

  quotes RouteQuote[]
  deals  RouteDeal[]

  @@unique([routeId, providerCompanyId])
  @@index([orgId, state])
}

enum QuoteState {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
  WITHDRAWN
}

/// Where a number came from. Not how much we like it.
///
/// Kept separate from confidence because they answer different questions: a
/// PRIOR can be held confidently and a QUOTE can be shaky, and collapsing the
/// two is how an engine estimate ends up in a revenue report.
enum EconomicsBasis {
  /// The engine's own estimate before anybody spoke to anybody.
  PRIOR
  /// At least one side is real, the other is still assumed.
  ESTIMATE
  /// Provider cost received and buyer price set.
  QUOTE
  /// Both sides committed at agreed numbers.
  COMMITMENT
  /// Money that actually moved.
  REALISED
}

enum EconomicsConfidence {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
}

/// A priced offer to the buyer, versioned.
///
/// Revisions never overwrite: a new version is written and the old one is
/// marked superseded, so "what did we send them in March" survives every later
/// negotiation.
model RouteQuote {
  id                  String  @id @default(cuid())
  orgId               String
  routeId             String
  version             Int
  requirementId       String
  providerCandidateId String?

  state QuoteState @default(DRAFT)

  currency     String   @default("USD")
  providerCost Decimal? @db.Decimal(14, 2)
  freight      Decimal? @db.Decimal(14, 2)
  fees         Decimal? @db.Decimal(14, 2)
  contingency  Decimal? @db.Decimal(14, 2)
  buyerPrice   Decimal? @db.Decimal(14, 2)

  grossProfit    Decimal?            @db.Decimal(14, 2)
  grossMarginPct Float?
  basis          EconomicsBasis      @default(ESTIMATE)
  confidence     EconomicsConfidence @default(UNKNOWN)
  /// True when no real provider cost backs this. Ranking must exclude these
  /// rather than treat a missing cost as a zero cost.
  costSideMissing Boolean            @default(true)

  workingCapitalAmount Decimal? @db.Decimal(14, 2)
  workingCapitalDays   Int?

  paymentTerms  String?
  deliveryTerms String?
  downsideNotes String?
  assumptions   String[] @default([])

  validUntil      DateTime?
  sentAt          DateTime?
  respondedAt     DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  declineReason   String?
  negotiationNote String?

  /// Computed at save time, so the gate does not depend on a screen being open.
  approvalRequired Boolean  @default(false)
  approvalReasons  String[] @default([])

  supersededById String?   @unique
  supersededAt   DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route             RouteHypothesis    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  requirement       BuyerRequirement   @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  providerCandidate ProviderCandidate? @relation(fields: [providerCandidateId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  supersededBy      RouteQuote?        @relation("QuoteVersions", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes        RouteQuote?        @relation("QuoteVersions")
  approvals         Approval[]
  deal              RouteDeal?
  rooms             DealRoom[]

  @@unique([routeId, version])
  @@index([orgId, state])
}

enum DealStage {
  COMMITTED
  IN_DELIVERY
  DELIVERED
  INVOICED
  PAID
  CLOSED
  CANCELLED
  DISPUTED
  LOST
}

/// How a commitment was actually made. A verbal yes is a commitment and it is
/// not a signed contract, and the difference decides how much capital we risk.
enum CommitmentBasis {
  VERBAL
  EMAIL
  PURCHASE_ORDER
  SIGNED_CONTRACT
}

/// A deal that exists because the buyer committed.
///
/// Buyer commitment and provider commitment are separate dated facts, and so
/// are delivery, invoicing and payment. Nothing in this model lets "they said
/// yes" render as "we were paid".
model RouteDeal {
  id      String @id @default(cuid())
  orgId   String
  routeId String @unique
  quoteId String @unique

  stage DealStage @default(COMMITTED)

  buyerCommittedAt        DateTime
  buyerCommitmentBasis    CommitmentBasis
  buyerCommitmentEvidence String
  buyerContactId          String?
  /// The agreed number, which is not the quoted number once anybody negotiates.
  contractedValue         Decimal?        @db.Decimal(14, 2)

  providerCandidateId        String?
  providerCommittedAt        DateTime?
  providerCommitmentBasis    CommitmentBasis?
  providerCommitmentEvidence String?
  contractedCost             Decimal?         @db.Decimal(14, 2)

  deliveryStartedAt   DateTime?
  deliveryCompletedAt DateTime?
  completionEvidence  String?

  cancelledAt     DateTime?
  cancelReason    String?
  disputeOpenedAt DateTime?
  disputeNotes    String?
  /// ours | provider | buyer | external. Who carried the failure, when one happened.
  responsibility  String?
  lostReason      String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route             RouteHypothesis    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  quote             RouteQuote         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  buyerContact      Contact?           @relation("DealBuyerContact", fields: [buyerContactId], references: [id], onDelete: SetNull)
  providerCandidate ProviderCandidate? @relation(fields: [providerCandidateId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  milestones DealMilestone[]
  payments   DealPayment[]

  @@index([orgId, stage])
}

model DealMilestone {
  id     String @id @default(cuid())
  dealId String

  label       String
  dueAt       DateTime?
  completedAt DateTime?
  /// What proves it happened. A tick with no evidence is an opinion.
  evidence    String?
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())

  deal RouteDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, sortOrder])
}

enum PaymentDirection {
  /// From the buyer to us.
  INBOUND
  /// From us to the provider.
  OUTBOUND
}

enum PaymentKind {
  INVOICE
  PAYMENT
  REFUND
  CHARGEBACK
  WRITE_OFF
}

/// One money line. An invoice is a claim; only a settled payment is money.
///
/// `settledAt` is the field that decides whether a row counts toward collected
/// gross profit, which is why it is nullable and separate from `dueAt`.
model DealPayment {
  id     String @id @default(cuid())
  orgId  String
  dealId String

  direction PaymentDirection
  kind      PaymentKind
  amount    Decimal          @db.Decimal(14, 2)
  currency  String           @default("USD")
  dueAt     DateTime?
  settledAt DateTime?
  reference String?
  notes     String?

  recordedById String?
  createdAt    DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal       RouteDeal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  recordedBy User?        @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([orgId, direction, settledAt])
  @@index([dealId, createdAt])
}

/// Append-only trail for every material deal transition.
///
/// Written inside the same transaction as the change it describes, unlike the
/// security audit log, which is deliberately best-effort so it can never fail a
/// user's request. Here the event is part of the change: a state transition
/// nobody can reconstruct is how a deal ends up with numbers no one can defend.
model DealEvent {
  id      String @id @default(cuid())
  orgId   String
  routeId String

  kind      String
  actorType String  @default("user")
  actorId   String?

  subjectType String
  subjectId   String?

  summary String
  before  Json    @default("{}")
  after   Json    @default("{}")
  /// What backs the change — a call, a document, an email, a payment reference.
  evidence String?
  /// The confidence claimed at the time, so a later revision cannot rewrite it.
  confidence String?
  /// Groups the events produced by one operator action.
  correlationId String?

  occurredAt DateTime @default(now())

  org   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route RouteHypothesis @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([orgId, occurredAt])
  @@index([routeId, occurredAt])
  @@index([subjectType, subjectId])
}

// ---------------------------------------------------------------------------
// Deal Room: a prospect-specific page, and what the prospect did with it
//
// The mechanic the previous system got right, with the parts it got wrong left
// out. What survives is the secure per-prospect link and the engagement ladder.
// What does not is the AI-receptionist framing and the "business audit" copy —
// language that promised an analysis nobody had performed.
//
// The test this section is written against: the page has to be worth reading
// with every button removed. If the only reason a prospect stays on it is the
// call to action, there was nothing on it worth sending.
// ---------------------------------------------------------------------------

/// How far a room has got with the prospect.
///
/// A ladder rather than a boolean, for the same reason the provider workstream
/// is one: "we sent it" and "they asked for a price" are six rungs apart and a
/// single `engaged` flag reports them identically.
enum RoomState {
  DRAFT
  SENT
  /// The channel confirmed delivery. Not every channel can, which is why this
  /// is distinct from SENT rather than assumed from it.
  DELIVERED
  OPENED
  RESPONDED
  DECLINED
  EXPIRED
}

enum RoomEventKind {
  CREATED
  SENT
  DELIVERED
  OPENED
  RESPONDED
  INFORMATION_SUPPLIED
  NEXT_STEP_REQUESTED
  QUOTE_REQUESTED
  PROOF_STEP_REQUESTED
  DECLINED
  EXPIRED
}

/// The reversible first step being offered, if any.
///
/// Deliberately a list rather than one universal trial. A seven-day pilot is
/// the right ask for a service route and meaningless for a distribution one,
/// and offering the wrong step reads as a form letter — which it is.
enum ProofStepKind {
  SAMPLE_ORDER
  SMALL_INITIAL_SHIPMENT
  SINGLE_LOCATION_PILOT
  ONE_TIME_SERVICE
  SITE_WALKTHROUGH
  PRELIMINARY_QUOTE
  LIMITED_SCOPE_SUBCONTRACT
  VENDOR_CAPABILITY_REVIEW
  PAID_DIAGNOSTIC
  /// Nothing can honestly be offered yet. A real answer, and the common one
  /// early on.
  NONE
}

model DealRoom {
  id      String @id @default(cuid())
  orgId   String
  routeId String

  /// The address. Long and random: the only thing standing between this page
  /// and the open internet, so it is generated from a CSPRNG and never derived
  /// from anything about the prospect.
  token String @unique

  state RoomState @default(DRAFT)

  /// What the room said when it was sent.
  ///
  /// Snapshotted rather than rendered live from current records. A prospect
  /// who opens the link three weeks later must see what we sent them, not what
  /// the engine believes today — otherwise the page silently rewrites itself
  /// and a conversation about it becomes unwinnable.
  content Json @default("{}")
  /// Which requirement version and quote the snapshot was built from.
  requirementId String?
  quoteId       String?

  proofStep       ProofStepKind @default(NONE)
  proofStepReason String?

  /// Who it was sent to, and how. Null until it is sent.
  contactId String?
  channel   String?

  sentAt      DateTime?
  deliveredAt DateTime?
  firstOpenAt DateTime?
  lastOpenAt  DateTime?
  openCount   Int       @default(0)
  respondedAt DateTime?
  declinedAt  DateTime?
  /// After this the link stops working. A room with no expiry is a public page
  /// about a named company that stays up forever.
  expiresAt   DateTime

  /// What the prospect typed back, kept exactly as they wrote it.
  responseNote String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route       RouteHypothesis   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  requirement BuyerRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  quote       RouteQuote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  contact     Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("RoomCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  events DealRoomEvent[]

  @@index([orgId, state])
  @@index([routeId, createdAt])
  @@index([expiresAt])
}

/// One thing that happened to a room. Append-only.
///
/// `dedupeKey` is what makes the ladder idempotent. A prospect who refreshes
/// four times has opened it once as far as anyone should care, and an email
/// client that prefetches links must not manufacture engagement that never
/// happened.
model DealRoomEvent {
  id     String @id @default(cuid())
  orgId  String
  roomId String

  kind RoomEventKind
  /// Whatever the prospect supplied with it, in their words.
  detail String?
  /// Coarse and deliberately not identifying: enough to tell a prefetch from a
  /// person, not enough to track anybody.
  userAgentClass String?

  /// Collapses repeats of the same event inside the same window.
  dedupeKey String

  occurredAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room DealRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, kind, dedupeKey])
  @@index([orgId, occurredAt])
  @@index([roomId, occurredAt])
}
