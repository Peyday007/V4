// Deal Dispatch — AI-Operated Deal Dispatch System
// Data model for subcontracting, brokerage, and distribution deal operations.
//
// Conventions:
//  - Every tenant-scoped row carries `orgId`. All queries must filter by it.
//  - Append-only history tables: DealStatusHistory, ActivityEvent, AuditEvent,
//    AIDecision, AIOverride, OpportunityScore. Never update or delete rows there.
//  - Facts carry provenance: source, confidence, and confirmation status.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Serverless runtimes open a connection per invocation, so DATABASE_URL
  // should point at a pooler (PgBouncer / Neon pooled endpoint). Migrations
  // cannot run through a pooler, so they use DIRECT_URL when it is set.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

