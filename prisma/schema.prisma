model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  roles                  Role[]
  companies              Company[]
  contacts               Contact[]
  opportunities          Opportunity[]
  settings               ConfigSetting[]
  industries             Industry[]
  services               Service[]
  products               Product[]
  materials              Material[]
  capabilities           Capability[]
  territories            Territory[]
  markets                Market[]
  businessPaths          BusinessPath[]
  hypotheses             PathHypothesis[]
  intentEvents           IntentEvent[]
  dataSources            DataSource[]
  dealLanes              DealLane[]
  auditEvents            AuditEvent[]
  demandEvents           DemandEvent[]
  routeHypotheses        RouteHypothesis[]
  sourceRuns             SourceRun[]
  demandOutcomes         DemandOutcome[]
  outreachStates         OutreachState[]
  outreachAttempts       OutreachAttempt[]
  jobs                   Job[]
  dailyPlans             DailyPlan[]
  scriptTemplates        ScriptTemplate[]
  qualificationQuestions QualificationQuestion[]
  contactResolutions     ContactResolution[]
  contactProvenance      ContactProvenance[]
  workPackets            WorkPacket[]
  packetItems            PacketItem[]
  workIncidents          WorkIncident[]
  buyerRequirements      BuyerRequirement[]
  providerCandidates     ProviderCandidate[]
  routeQuotes            RouteQuote[]
  routeDeals             RouteDeal[]
  dealPayments           DealPayment[]
  dealEvents             DealEvent[]
  dealRooms              DealRoom[]
  dealRoomEvents         DealRoomEvent[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  category    String
  roles       RolePermission[]
}

model Role {
  id          String   @id @default(cuid())
  orgId       String?
  key         String
  name        String
  description String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  org         Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]

  @@unique([orgId, key])
  @@index([orgId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String    @id @default(cuid())
  orgId        String
  email        String
  name         String
  passwordHash String
  roleId       String
  isActive     Boolean   @default(true)
  timezone     String    @default("America/New_York")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id])
  sessions      Session[]
  callerProfile CallerProfile?

  assignedCalls      CallAssignment[]    @relation("AssignedCaller")
  ownedOpportunities Opportunity[]       @relation("OpportunityOwner")
  ownedTasks         Task[]              @relation("TaskOwner")
  calls              Call[]
  escalationsRaised  Escalation[]        @relation("EscalationRaisedBy")
  escalationsOwned   Escalation[]        @relation("EscalationAssignee")
  approvalsRequested Approval[]          @relation("ApprovalRequester")
  approvalsDecided   Approval[]          @relation("ApprovalDecider")
  overrides          AIOverride[]
  notifications      Notification[]
  activityEvents     ActivityEvent[]
  metrics            PerformanceMetric[]
  auditEvents        AuditEvent[]
  messagesSent       Message[]

  outreachAttempts OutreachAttempt[]
  workPackets      WorkPacket[]      @relation("PacketCaller")
  incidents        WorkIncident[]    @relation("IncidentCaller")

  requirementsCaptured BuyerRequirement[] @relation("RequirementCapturedBy")
  roomsCreated         DealRoom[]         @relation("RoomCreatedBy")
  quotesCreated        RouteQuote[]       @relation("QuoteCreatedBy")
  dealsCreated         RouteDeal[]        @relation("DealCreatedBy")
  paymentsRecorded     DealPayment[]      @relation("PaymentRecordedBy")

  @@unique([orgId, email])
  @@index([orgId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CallerProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// Hash of this caller's personal PIN. Never the PIN itself, and never
  /// shared: one PIN per person is what makes every read and write in the
  /// caller workspace attributable to somebody.
  pinHash            String?
  pinSetAt           DateTime?
  pinLastUsedAt      DateTime?
  /// Consecutive failures. A PIN is short, so it needs a lockout that a
  /// password does not.
  pinFailedCount     Int       @default(0)
  pinLockedUntil     DateTime?
  /// Revoked without deleting the person, their assignments or their history.
  pinRevokedAt       DateTime?
  timezone           String    @default("America/New_York")
  languages          String[]  @default(["en"])
  industryStrengths  String[]  @default([])
  callTypeStrengths  String[]  @default([])
  maxDailyCalls      Int       @default(40)
  coldCallSkill      Float     @default(0.5)
  warmCallSkill      Float     @default(0.5)
  objectionSkill     Float     @default(0.5)
  extractionAccuracy Float     @default(0.5)
  buyerSideSkill     Float     @default(0.5)
  supplySideSkill    Float     @default(0.5)
  notes              String?
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

