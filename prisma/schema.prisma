/// local source; one that can answer "every state" is a national one, and the
/// scope tells the connector which question it is being asked.
enum MarketScope {
  /// The whole country. Connectors iterate their own national partitions.
  NATIONAL
  /// One or more states.
  STATE
  /// A metropolitan statistical area, expressed as a centre and radius.
  METRO
  COUNTY
  CITY
  /// An explicit list of postal codes.
  POSTAL
  /// A point and a radius, independent of administrative boundaries.
  RADIUS
}

