# ---------------------------------------------------------------------------
# Deal Dispatch — environment template
#
# The application boots and runs its full operating loop with only the Required
# block below filled in. Every external provider has a mock implementation, so
# discovery, calling, transcription, extraction, matching, deal configuration
# and the dispatch board all work end to end with no credentials at all.
# ---------------------------------------------------------------------------

# Required ------------------------------------------------------------------
# Runtime connection. On a serverless host (Vercel) this MUST be a pooled
# endpoint — Neon's "-pooler" host, Supabase's port 6543, or PgBouncer — because
# every function invocation opens its own connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealdispatch?schema=public"

# Non-pooled connection, used only for migrations (poolers cannot run DDL).
# Running your own Postgres? Set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dealdispatch?schema=public"

# Minimum 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-value-at-least-32-chars"

# Public URL of the deployment. Used for webhook callbacks and signed links.
APP_URL="http://localhost:3000"

# Shared secret the scheduler presents to /api/cron. Without it, scheduled
# runs are disabled and return 503. Generate with: openssl rand -hex 32
CRON_SECRET="change-me-to-a-long-random-value"

# AI ------------------------------------------------------------------------
# "mock" runs the deterministic rule engines only — every feature still works
# and results are repeatable. "anthropic" layers an LLM over the same rules and
# falls back to them automatically on any error.
LLM_PROVIDER="mock"                  # mock | anthropic
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"

# Telephony -----------------------------------------------------------------
TELEPHONY_PROVIDER="mock"            # mock | twilio
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM_NUMBER="+15550000000"
# TWILIO_WEBHOOK_SECRET="..."

# SMS -----------------------------------------------------------------------
# Mock captures messages in memory — nothing is delivered, but cost, segments,
# consent gating and reply outcomes are all recorded so channel comparison works.
SMS_PROVIDER="mock"                  # mock | twilio
# TWILIO_SMS_FROM_NUMBER="+15550000000"   # reuses TWILIO_ACCOUNT_SID / AUTH_TOKEN

# Transcription -------------------------------------------------------------
TRANSCRIPTION_PROVIDER="mock"        # mock | deepgram
# DEEPGRAM_API_KEY="..."

# Email ---------------------------------------------------------------------
EMAIL_PROVIDER="mock"                # mock | smtp
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
EMAIL_FROM="ops@example.com"

# Object storage ------------------------------------------------------------
STORAGE_PROVIDER="local"             # local | s3
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET="deal-dispatch-files"
# S3_REGION="us-east-1"

# Background worker ---------------------------------------------------------
WORKER_CONCURRENCY="2"
WORKER_POLL_MS="2000"

# Lead discovery ------------------------------------------------------------
# Discovery is only real if a live source is configured. With none of these
# set, the only enabled live source is municipal open data, which needs no key.
# Everything else falls back to the demonstration fixtures, and the interface
# labels those as demo rather than presenting them as discovered leads.

# Municipal open data (Socrata / SODA) — building permits, certificates of
# occupancy, business licences. Public records, no key required. An app token
# is optional and only raises the shared rate limit.
# Register at https://evergreen.data.socrata.com/signup
# SOCRATA_APP_TOKEN="..."

# Google Places (New) — provider discovery and the commercial buyer universe.
# Billed per request; the field mask in the connector is kept minimal for that
# reason. Enable the "Places API (New)" in a Google Cloud project.
# NOTE: Google's terms permit storing the place ID indefinitely but not the
# rest of the place content. The connector is written to that rule.
# https://developers.google.com/maps/documentation/places/web-service/text-search
# GOOGLE_PLACES_API_KEY="..."

# SAM.gov federal contract opportunities. Free, but a non-federal key allows
# only about ten requests per day, and public-sector work carries long award
# and payment cycles — so this source ships DISABLED and is opt-in.
# Request a key from your SAM.gov account under Account Details.
# https://open.gsa.gov/api/get-opportunities-public-api/
# SAM_GOV_API_KEY="..."

# Overrides the User-Agent every discovery connector sends. Some public APIs
# sit behind security appliances that judge this header and return an HTML
# block page rather than an API error — USAspending does this for some egress
# ranges. Changing it here avoids a code deploy to try a different value.
# DISCOVERY_USER_AGENT="DealDispatch/1.0 (automated lead discovery)"
