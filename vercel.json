{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && node scripts/deployMigrate.mjs && next build",
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 11 * * *"
    }
  ]
}
